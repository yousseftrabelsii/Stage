SECRET_KEY=change-me-in-production

# Switched to SQLite using an absolute path to fix the "unable to open database file" error on Windows.
DATABASE_URL=sqlite:///c:/Users/USER/Desktop/Stage/backend/instance/invoice_assistant.db

# File storage
UPLOAD_FOLDER=uploads
EXPORT_FOLDER=exports

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Tesseract
TESSERACT_LANGUAGES=fra+eng
TESSDATA_DIR=D:\programme\Tesseract-OCR\tessdata

# Windows Tesseract binary path
TESSERACT_CMD=D:\programme\Tesseract-OCR\tesseract.exe

# Auto-create DB tables on first run
AUTO_CREATE_DATABASE=true
